# Reference Caddyfile for Hostinger VPS Deployment
# Copy relevant blocks into /etc/caddy/Caddyfile on the VPS server.

# Redirect WWW to Apex Domain (301 Permanent Redirect for SEO)
www.pradeepnadig.in {
    redir https://pradeepnadig.in{uri} permanent
}

pradeepnadig.in {
    # Route API endpoints directly to FastAPI backend container
    handle_path /api/* {
        rewrite * /api{path}
        reverse_proxy 127.0.0.1:8000
    }

    # Block API documentation endpoints in reverse proxy (defense-in-depth)
    @blocked_docs path /docs* /redoc* /openapi.json* /api/v1/openapi.json*
    respond @blocked_docs 404

    # Route all other web traffic to Next.js frontend container
    handle {
        reverse_proxy 127.0.0.1:3000
    }

    # Security Headers & Compression
    encode gzip zstd
    header {
        Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        X-XSS-Protection "0"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), accelerometer=(), gyroscope=(), magnetometer=(), usb=()"
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://news.google.com https://checkout.razorpay.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https: blob:; connect-src 'self' https://pradeepnadig.in https://*.supabase.co https://api.razorpay.com https://www.google-analytics.com https://www.googletagmanager.com; frame-src 'self' https://api.razorpay.com https://checkout.razorpay.com https://www.youtube.com https://www.youtube-nocookie.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self';"
        -Server
        -X-Powered-By
    }
}

# Secondary domain placeholder setup (Ready for future expansion)
shaankaricreations.in, www.shaankaricreations.in {
    encode gzip zstd
    respond "Domain reserved for Shaankari Creations" 200
}
